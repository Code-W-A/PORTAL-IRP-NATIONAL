rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep the existing portal policy outside the guide.
    match /{collection}/{document=**} {
      allow read: if !guideCollection(collection);
      allow write: if !guideCollection(collection) && request.auth != null;
    }

    function guideCollection(collection) {
      return collection in ['GhidComunicare', 'GhidComunicareCategorii', 'GhidComunicareFavorite'];
    }

    function validCategoryId(id) {
      return id is string && id.matches('^[a-f0-9]{64}$');
    }

    function categoryExists(ids, index) {
      return ids.size() <= index || (validCategoryId(ids[index])
        && exists(/databases/$(database)/documents/GhidComunicareCategorii/$(ids[index])));
    }

    function validCategories(data) {
      let ids = data.get('categoryIds', []);
      return ids is list && ids.size() <= 5 && ids.toSet().size() == ids.size()
        && categoryExists(ids, 0) && categoryExists(ids, 1) && categoryExists(ids, 2)
        && categoryExists(ids, 3) && categoryExists(ids, 4);
    }

    match /GhidComunicareCategorii/{categoryId} {
      allow read: if hasIrpProfile();
      allow create: if hasIrpProfile() && validCategoryId(categoryId)
        && request.resource.data.keys().hasOnly(['name', 'createdBy'])
        && text(request.resource.data.name, 60) && request.resource.data.createdBy == request.auth.uid;
    }

    match /GhidComunicareFavorite/{uid}/Situatii/{situationId} {
      function ownsFavorites() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read, delete: if ownsFavorites();
      allow create: if ownsFavorites() && hasIrpProfile() && validId(situationId)
        && request.resource.data.keys().hasOnly(['savedAt'])
        && request.resource.data.savedAt == request.time
        && get(/databases/$(database)/documents/GhidComunicare/$(situationId)).data.status == 'active';
    }

    function validId(value) {
      return value is string && value.matches('^[a-zA-Z0-9_-]{1,128}$');
    }

    function validCreationId(value) {
      return value.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$');
    }

    function hasIrpProfile() {
      return request.auth != null && validProfile(
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data
      );
    }

    function validProfile(profile) {
      return validId(profile.judetId) && validId(profile.structuraId);
    }

    function text(value, max) {
      return value is string && value.size() > 0 && value.size() <= max;
    }

    function isoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
    }

    function owns(data) {
      return data.author.uid == request.auth.uid;
    }

    function validAuthor(data) {
      return data.author is map && data.author.keys().hasOnly(['uid', 'name'])
        && owns(data) && text(data.author.name, 300);
    }

    function validFollowUp(pair) {
      return pair.question is string && pair.answer is string;
    }

    function validFollowUps(pairs) {
      return pairs is list && pairs.size() <= 30 && (pairs.size() == 0 || validFollowUpEntries(pairs));
    }

    function validFollowUpEntries(pairs) {
      // Pad the list so the checks fit the rule expression limit even at 30 entries.
      let empty = [{'question': '', 'answer': ''}];
      let two = empty.concat(empty);
      let four = two.concat(two);
      let eight = four.concat(four);
      let sixteen = eight.concat(eight);
      let entries = pairs.concat(sixteen).concat(sixteen);
      return validFollowUp(entries[0]) && validFollowUp(entries[1]) && validFollowUp(entries[2])
        && validFollowUp(entries[3]) && validFollowUp(entries[4]) && validFollowUp(entries[5])
        && validFollowUp(entries[6]) && validFollowUp(entries[7]) && validFollowUp(entries[8])
        && validFollowUp(entries[9]) && validFollowUp(entries[10]) && validFollowUp(entries[11])
        && validFollowUp(entries[12]) && validFollowUp(entries[13]) && validFollowUp(entries[14])
        && validFollowUp(entries[15]) && validFollowUp(entries[16]) && validFollowUp(entries[17])
        && validFollowUp(entries[18]) && validFollowUp(entries[19]) && validFollowUp(entries[20])
        && validFollowUp(entries[21]) && validFollowUp(entries[22]) && validFollowUp(entries[23])
        && validFollowUp(entries[24]) && validFollowUp(entries[25]) && validFollowUp(entries[26])
        && validFollowUp(entries[27]) && validFollowUp(entries[28]) && validFollowUp(entries[29]);
    }

    function validSituation(data) {
      return data.status == 'active' && text(data.question, 1000) && text(data.answer, 20000)
        && validFollowUps(data.followUps) && data.searchText is string && data.searchText.size() <= 1000000;
    }

    function withdrawnSituation(data) {
      return data.status == 'withdrawn' && data.question == '' && data.answer == ''
        && data.followUps == [] && data.searchText == '';
    }

    match /GhidComunicare/{situationId} {
      function situationPath() {
        return /databases/$(database)/documents/GhidComunicare/$(situationId);
      }

      function completionPath(completionId) {
        return /databases/$(database)/documents/GhidComunicare/$(situationId)/Completari/$(completionId);
      }

      function editsSituation() {
        let data = request.resource.data;
        return owns(resource.data) && resource.data.status == 'active'
          && data.diff(resource.data).affectedKeys().hasOnly(
            ['question', 'answer', 'followUps', 'searchText', 'status', 'updatedAt', 'categoryIds']
          )
          && isoDate(data.updatedAt)
          && (data.diff(resource.data).affectedKeys().hasAny(['categoryIds'])
            ? data.status == 'active' && validCategories(data) : true)
          && (validSituation(data) || withdrawnSituation(data));
      }

      function updatesCompletionCount() {
        let data = request.resource.data;
        return data.diff(resource.data).affectedKeys().hasOnly(['completionCount', 'completionChangeId'])
          && data.completionCount is int && data.completionCount >= 0 && validId(data.completionChangeId)
          && matchesCompletionChange(completionPath(data.completionChangeId));
      }

      function matchesCompletionChange(path) {
        let change = request.resource.data.completionCount - resource.data.completionCount;
        return (change == 1 && resource.data.status == 'active' && !exists(path)
            && existsAfter(path) && owns(getAfter(path).data))
          || (change == -1 && exists(path) && owns(get(path).data) && !existsAfter(path));
      }

      function countChangedFor(completionId, change) {
        let before = get(situationPath()).data;
        let after = getAfter(situationPath()).data;
        return after.completionChangeId == completionId
          && after.completionCount == before.completionCount + change
          && (change == -1 || before.status == 'active');
      }

      allow read: if hasIrpProfile();
      allow create: if hasIrpProfile() && validCreationId(situationId)
        && request.resource.data.keys().hasOnly(
          ['question', 'answer', 'followUps', 'searchText', 'status', 'author', 'createdAt', 'updatedAt', 'completionCount', 'categoryIds']
        )
        && validAuthor(request.resource.data) && validCategories(request.resource.data) && validSituation(request.resource.data)
        && request.resource.data.completionCount is int && request.resource.data.completionCount == 0
        && isoDate(request.resource.data.createdAt)
        && request.resource.data.createdAt == request.resource.data.updatedAt;
      allow update: if hasIrpProfile() && (editsSituation() || updatesCompletionCount());

      match /Completari/{completionId} {
        allow read: if hasIrpProfile();
        allow create: if hasIrpProfile() && validCreationId(completionId)
          && request.resource.data.keys().hasOnly(['text', 'author', 'createdAt', 'updatedAt'])
          && validAuthor(request.resource.data) && text(request.resource.data.text, 10000)
          && isoDate(request.resource.data.createdAt)
          && request.resource.data.createdAt == request.resource.data.updatedAt
          && countChangedFor(completionId, 1);
        allow update: if hasIrpProfile() && owns(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'updatedAt'])
          && text(request.resource.data.text, 10000) && isoDate(request.resource.data.updatedAt);
        allow delete: if hasIrpProfile() && owns(resource.data) && countChangedFor(completionId, -1);
      }
    }
  }
}
